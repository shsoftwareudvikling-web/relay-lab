{
  "name": "@ibrahim/relay-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "python scripts/dev.py",
    "dev:web": "vite --port 5179 --strictPort",
    "dev:api": "python backend/server.py",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "python -m unittest discover -s backend/tests -v"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
